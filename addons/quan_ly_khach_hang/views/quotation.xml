<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_quotation_form" model="ir.ui.view">
            <field name="name">qlkh.quotation.form</field>
            <field name="model">qlkh.quotation</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button
                            name="action_send_email"
                            type="object"
                            string="Gửi email"
                            class="btn-primary"
                            attrs="{'invisible': [('status', 'in', ['da_gui','chap_nhan','tu_choi'])]}"/>
                        <button
                            name="action_mark_viewed"
                            type="object"
                            string="Đã xem"
                            class="btn-secondary"
                            attrs="{'invisible': [('status', '!=', 'da_gui')]}"/>
                        <button
                            name="action_set_negotiation"
                            type="object"
                            string="Đàm phán"
                            class="btn-warning"
                            attrs="{'invisible': [('status', 'in', ['dam_phan','chap_nhan','tu_choi'])]}"/>
                        <button
                            name="action_reject"
                            type="object"
                            string="Từ chối"
                            class="btn-danger"
                            attrs="{'invisible': [('status', 'in', ['chap_nhan','tu_choi'])]}"/>
                        <button
                            name="action_accept_quotation"
                            type="object"
                            string="Chấp nhận"
                            class="btn-primary"
                            attrs="{'invisible': [('status', 'in', ['chap_nhan', 'tu_choi'])]}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="customer_id" options="{'no_create': True}"/>
                                <field name="source"/>
                                <field name="date"/>
                                <field name="quotation_value" widget="monetary"/>
                            </group>
                            <group>
                                <field name="status" widget="statusbar" statusbar_visible="nhap,da_gui,dam_phan,chap_nhan"/>
                                <field name="meet_url" readonly="1"/>
                                <field name="file" filename="file_name"/>
                                <field name="file_name" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Chi tiết sản phẩm">
                                <field name="line_ids" context="{'default_quotation_id': active_id}">
                                    <tree editable="bottom" decoration-info="quantity > 10">
                                        <field name="product_name" placeholder="Tên sản phẩm (tự động)" readonly="1"/>
                                        <field name="description" placeholder="Mô tả..."/>
                                        <field name="quantity" sum="Tổng số lượng"/>
                                        <field name="unit_price" widget="monetary"/>
                                        <field name="vat_rate" widget="percentage"/>
                                        <field name="product_id" placeholder="Chọn sản phẩm IoT..."/>
                                        <field name="price_subtotal" widget="monetary" sum="Tổng thành tiền"/>
                                        <field name="price_tax" widget="monetary" sum="Tổng VAT"/>
                                        <field name="price_total" widget="monetary" sum="Tổng cộng"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Hợp đồng liên quan">
                                <field name="contract_ids">
                                    <tree>
                                        <field name="name"/>
                                        <field name="date_start"/>
                                        <field name="date_end"/>
                                        <field name="contract_value" widget="monetary"/>
                                        <field name="status"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Ghi chú">
                                <field name="note" nolabel="1" placeholder="Ghi chú về báo giá..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_quotation_tree" model="ir.ui.view">
            <field name="name">qlkh.quotation.tree</field>
            <field name="model">qlkh.quotation</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="date"/>
                    <field name="quotation_value" widget="monetary" sum="Tổng giá trị"/>
                    <field name="status" decoration-success="status == 'chap_nhan'" decoration-danger="status == 'tu_choi'" decoration-warning="status == 'dam_phan'" decoration-info="status == 'da_gui'"/>
                    <field name="meet_url"/>
                </tree>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_quotation_search" model="ir.ui.view">
            <field name="name">qlkh.quotation.search</field>
            <field name="model">qlkh.quotation</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="date"/>
                    <field name="status"/>
                    <separator/>
                    <filter name="my_quotations" string="Báo giá của tôi" domain="[('customer_id.nhan_vien_phu_trach_id', '=', uid)]"/>
                    <filter name="approved" string="Đã chấp nhận" domain="[('status', '=', 'chap_nhan')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_status" string="Trạng thái" context="{'group_by': 'status'}"/>
                        <filter name="group_by_customer" string="Khách hàng" context="{'group_by': 'customer_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Action -->
        <record id="action_quotation" model="ir.actions.act_window">
            <field name="name">Báo giá</field>
            <field name="res_model">qlkh.quotation</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_quotation_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Tạo báo giá mới cho khách hàng
                </p>
                <p>
                    Quản lý báo giá và theo dõi trạng thái phê duyệt.
                </p>
            </field>
        </record>
    </data>
</odoo>