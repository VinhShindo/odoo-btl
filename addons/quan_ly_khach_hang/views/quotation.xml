<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_quotation_form" model="ir.ui.view">
            <field name="name">qlkh.quotation.form</field>
            <field name="model">qlkh.quotation</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="date"/>
                            <field name="status"/>
                            <field name="file"/>
                            <field name="file_name"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_quotation_tree" model="ir.ui.view">
            <field name="name">qlkh.quotation.tree</field>
            <field name="model">qlkh.quotation</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="date"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>
        <record id="action_quotation" model="ir.actions.act_window">
            <field name="name">Báo giá</field>
            <field name="res_model">qlkh.quotation</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
