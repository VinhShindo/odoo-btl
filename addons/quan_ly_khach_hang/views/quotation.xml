<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_quotation_form" model="ir.ui.view">
            <field name="name">qlkh.quotation.form</field>
            <field name="model">qlkh.quotation</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button
                            name="action_accept_quotation"
                            type="object"
                            string="Chấp nhận"
                            class="btn-primary"
                            invisible="status == 'chap_nhan'"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="customer_id"/>
                            <field name="date"/>
                            <field name="status" widget="statusbar"/>
                            <field name="file"/>
                        <field name="file_name"/>
                        <field name="quotation_value"/>
                        <field name="note"/>
                    </group>
                    <notebook>
                        <page string="Chi tiết sản phẩm">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="description"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="vat_rate"/>
                                    <field name="price_subtotal"/>
                                    <field name="price_tax"/>
                                    <field name="price_total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
            </field>
        </record>
        <record id="view_quotation_tree" model="ir.ui.view">
            <field name="name">qlkh.quotation.tree</field>
            <field name="model">qlkh.quotation</field>
            <field name="arch" type="xml">
                <tree
    decoration-success="status=='chap_nhan'"
    decoration-danger="status=='tu_choi'"
    decoration-warning="status=='dam_phan'">
                    <field name="name"/>
                    <field name="customer_id"/>
                    <field name="date"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>
        <record id="action_quotation" model="ir.actions.act_window">
            <field name="name">Báo giá</field>
            <field name="res_model">qlkh.quotation</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
