<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_contract_product_form" model="ir.ui.view">
            <field name="name">qlkh.contract.product.form</field>
            <field name="model">qlkh.contract_product</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="category"/>
                            <field name="device_type"/>
                        </group>
                        <group>
                            <field name="list_price"/>
                            <field name="cost_price"/>
                            <field name="warranty"/>
                            <field name="connectivity"/>
                        </group>
                        <group>
                            <field name="technical_specs"/>
                            <field name="support_info"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_contract_product_tree" model="ir.ui.view">
            <field name="name">qlkh.contract.product.tree</field>
            <field name="model">qlkh.contract_product</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="category"/>
                    <field name="device_type"/>
                    <field name="list_price"/>
                </tree>
            </field>
        </record>

        <record id="action_contract_product" model="ir.actions.act_window">
            <field name="name">Danh mục sản phẩm IoT</field>
            <field name="res_model">qlkh.contract_product</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- ĐÃ XÓA dòng menuitem này vì đã có trong menu.xml -->
    </data>
</odoo>