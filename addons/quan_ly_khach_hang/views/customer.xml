<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_customer_form" model="ir.ui.view">
            <field name="name">qlkh.customer.form</field>
            <field name="model">qlkh.customer</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="customer_type"/>
                            <field name="status"/>
                            <field name="nhan_vien_phu_trach_id"/>
                            <field name="iot_device"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="address"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_customer_tree" model="ir.ui.view">
            <field name="name">qlkh.customer.tree</field>
            <field name="model">qlkh.customer</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="customer_type"/>
                    <field name="status"/>
                    <field name="nhan_vien_phu_trach_id"/>
                </tree>
            </field>
        </record>
        <record id="action_customer" model="ir.actions.act_window">
            <field name="name">Khách hàng</field>
            <field name="res_model">qlkh.customer</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
