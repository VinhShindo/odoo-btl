<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_customer_form" model="ir.ui.view">
            <field name="name">qlkh.customer.form</field>
            <field name="model">qlkh.customer</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="customer_type"/>
                                <field name="status" widget="statusbar" statusbar_visible="tiem_nang,da_xac_thuc,dang_tu_van,da_gui_bao_gia,dam_phan,sap_ky_hd,thanh_cong,that_bai"/>
                            </group>
                            <group>
                                <field name="area"/>
                                <field name="industry"/>
                                <field name="expected_revenue" widget="monetary"/>
                                <field name="priority"/>
                                <field name="nhan_vien_phu_trach_id"/>
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="email"/>
                                <field name="phone"/>
                                <field name="iot_device"/>
                            </group>
                        </group>
                        <group>
                            <field name="address"/>
                            <field name="note"/>
                        </group>
                        <group string="Chỉ số khách hàng">
                            <field name="interaction_count"
                                readonly="1"/>
                            <field name="quotation_count"
                                readonly="1"/>
                            <field name="contract_count"
                                readonly="1"/>
                            <field name="revenue_total"
                                readonly="1"/>
                        </group>
                            <notebook>
                                <page string="Sản phẩm/Dịch vụ">
                                    <field name="product_ids">
                                        <tree editable="bottom">
                                            <field name="name"/>
                                            <field name="code"/>
                                            <field name="device_type"/>
                                            <field name="list_price" widget="monetary"/>
                                            <field name="active"/>
                                        </tree>
                                    </field>
                                </page>
                            </notebook>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_customer_tree" model="ir.ui.view">
            <field name="name">qlkh.customer.tree</field>
            <field name="model">qlkh.customer</field>
            <field name="arch" type="xml">
                <tree decoration-success="status=='thanh_cong'"
                    decoration-danger="status=='that_bai'"
                    decoration-warning="status=='dam_phan'">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="customer_type"/>
                    <field name="status"/>
                    <field name="expected_revenue" widget="monetary"/>
                    <field name="nhan_vien_phu_trach_id"/>
                    <field name="revenue_total"/>
                </tree>
            </field>
        </record>
        <record id="action_customer" model="ir.actions.act_window">
            <field name="name">Khách hàng</field>
            <field name="res_model">qlkh.customer</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
