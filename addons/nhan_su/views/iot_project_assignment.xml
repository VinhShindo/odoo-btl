<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_iot_project_assignment_form" model="ir.ui.view">
            <field name="name">iot_project_assignment.form</field>
            <field name="model">iot_project_assignment</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="nhan_vien_id"/>
                            <field name="role"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_iot_project_assignment_tree" model="ir.ui.view">
            <field name="name">iot_project_assignment.tree</field>
            <field name="model">iot_project_assignment</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="nhan_vien_id"/>
                    <field name="role"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                </tree>
            </field>
        </record>
        <record id="action_iot_project_assignment" model="ir.actions.act_window">
            <field name="name">Phân công dự án IoT</field>
            <field name="res_model">iot_project_assignment</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="menu_iot_project_assignment" name="Phân công dự án IoT" parent="menu_root" action="action_iot_project_assignment" sequence="100"/>
    </data>
</odoo>
