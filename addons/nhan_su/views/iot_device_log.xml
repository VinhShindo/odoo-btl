<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_iot_device_log_form" model="ir.ui.view">
            <field name="name">iot_device_log.form</field>
            <field name="model">iot_device_log</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="device_name"/>
                            <field name="device_code"/>
                            <field name="nhan_vien_id"/>
                            <field name="event_type"/>
                            <field name="event_date"/>
                            <field name="note"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_iot_device_log_tree" model="ir.ui.view">
            <field name="name">iot_device_log.tree</field>
            <field name="model">iot_device_log</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="device_name"/>
                    <field name="device_code"/>
                    <field name="nhan_vien_id"/>
                    <field name="event_type"/>
                    <field name="event_date"/>
                </tree>
            </field>
        </record>
        <record id="action_iot_device_log" model="ir.actions.act_window">
            <field name="name">Lịch sử sử dụng thiết bị IoT</field>
            <field name="res_model">iot_device_log</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="menu_iot_device_log" name="Lịch sử sử dụng thiết bị IoT" parent="menu_root" action="action_iot_device_log" sequence="101"/>
    </data>
</odoo>
