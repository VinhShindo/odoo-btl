<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_nhan_vien_form" model="ir.ui.view">
            <field name="name">nhan_vien.form</field>
            <field name="model">hr.employee</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                                <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                            </button>
                        </div>
                        <div class="oe_title">
                            <h1>
                                <field name="ho_va_ten" placeholder="Họ và tên"/>
                            </h1>
                        </div>
                        <group col="4" string="Thông tin cơ bản">
                            <field name="ho_ten_dem" placeholder="Họ tên đệm"/>
                            <field name="ten" placeholder="Tên"/>
                            <field name="ma_dinh_danh" placeholder="Mã định danh"/>
                            <field name="work_email" widget="email"/>
                            <field name="work_phone" widget="phone"/>
                            <field name="birthday"/>
                            <field name="tuoi" readonly="1"/>
                        </group>
                        <group col="4" string="Thông tin công việc">
                            <field name="don_vi_id"/>
                            <field name="company_id" options="{'no_create': True}"/>
                        </group>
                        <group col="4" string="Thông tin chi tiết">
                            <field name="que_quan" placeholder="Quê quán"/>
                            <field name="so_nguoi_bang_tuoi" readonly="1"/>
                            <field name="image_1920" widget="image" class="oe_avatar"/>
                        </group>
                        <group col="4" string="Hồ sơ điện tử">
                            <field name="folder_id" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="KPI &amp; Khách hàng">
                                <group col="2">
                                    <group string="Số lượng">
                                        <field name="so_khach_hang_phu_trach" readonly="1"/>
                                        <field name="so_bao_gia" readonly="1"/>
                                        <field name="so_hop_dong" readonly="1"/>
                                        <field name="so_van_ban_xu_ly" readonly="1"/>
                                    </group>
                                    <group string="KPI">
                                        <field name="diem_kpi" readonly="1"/>
                                        <field name="muc_tieu_doanh_so" readonly="1"/>
                                        <field name="tien_do_kpi" readonly="1"/>
                                    </group>
                                </group>
                                <field name="ghi_chu_nhan_su" readonly="1" nolabel="1"/>
                            </page>
                            <page string="Lịch sử công tác">
                                <field name="lich_su_cong_tac_ids">
                                    <tree>
                                        <field name="chuc_vu_id"/>
                                        <field name="don_vi_id"/>
                                        <field name="loai_chuc_vu"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Chứng chỉ &amp; Bằng cấp">
                                <field name="danh_sach_chung_chi_bang_cap_ids">
                                    <tree>
                                        <field name="chung_chi_bang_cap_id"/>
                                        <field name="ghi_chu"/>
                                        <field name="ma_dinh_danh"/>
                                    </tree>
                                </field>
                            </page>
                            <page string="Hồ sơ điện tử">
                                <field name="ho_so_dien_tu_ids" context="{'default_nhan_vien_id': active_id}">
                                    <tree editable="bottom">
                                        <field name="ho_so"/>
                                        <field name="loai_ho_so"/>
                                        <field name="ten_file"/>
                                        <field name="ngay_dang_tai"/>
                                    </tree>
                                    <form>
                                        <group col="2">
                                            <group>
                                                <field name="nhan_vien_id" invisible="1"/>
                                                <field name="ho_so" placeholder="Tên hồ sơ..."/>
                                                <field name="loai_ho_so"/>
                                                <field name="ten_file" placeholder="Tên file..."/>
                                            </group>
                                            <group>
                                                <field name="ngay_dang_tai"/>
                                                <field name="van_ban_id" readonly="1"/>
                                            </group>
                                        </group>
                                        <group>
                                            <field name="tep_dinh_kem" filename="ten_file" widget="binary" placeholder="Tệp đính kèm..."/>
                                        </group>
                                        <group>
                                            <field name="note" placeholder="Ghi chú..."/>
                                        </group>
                                    </form>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_nhan_vien_tree" model="ir.ui.view">
            <field name="name">nhan_vien.tree</field>
            <field name="model">hr.employee</field>
            <field name="priority">1</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="ho_va_ten"/>
                    <field name="ma_dinh_danh"/>
                    <field name="don_vi_id"/>
                    <field name="work_email"/>
                    <field name="tuoi"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="nhan_vien_search">
            <field name="model">hr.employee</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ma_dinh_danh"/>
                    <field name="ho_va_ten"/>
                    <field name="birthday"/>
                    <field name="tuoi"/>
                    <field name="que_quan"/>
                    <field name="work_email"/>
                    <field name="don_vi_id"/>
                </search>
            </field>
        </record>

        <record id="action_nhan_vien" model="ir.actions.act_window">
            <field name="name">Nhân viên</field>
            <field name="res_model">hr.employee</field>
            <field name="view_mode">tree,form</field>
            <field name="views" eval="[(ref('view_nhan_vien_tree'), 'tree'), (ref('view_nhan_vien_form'), 'form')]"/>
            <field name="search_view_id" ref="nhan_vien_search"/>
            <field name="view_id" ref="view_nhan_vien_tree" />
        </record>
    </data>
</odoo>

