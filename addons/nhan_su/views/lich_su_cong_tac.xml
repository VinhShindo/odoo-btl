<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- FORM VIEW (Popup thêm mới) -->
        <record id="view_lich_su_cong_tac_form" model="ir.ui.view">
            <field name="name">lich_su_cong_tac</field>
            <field name="model">lich_su_cong_tac</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div class="oe_read_only" style="font-size:20px; font-weight:bold;">Thêm lịch sử công tác</div>
                        <group col="4" string="Thông tin">
                            <!-- Ẩn nhan_vien_id vì đã tự động gán từ context -->
                            <field name="nhan_vien_id" invisible="1"/>
                            <field name="chuc_vu_id" required="1" placeholder="Chọn chức vụ..."/>
                            <field name="don_vi_id" required="1" placeholder="Chọn phòng ban..."/>
                            <field name="loai_chuc_vu" default="Chính"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- TREE VIEW (Danh sách hiển thị trên tab) -->
        <record id="view_lich_su_cong_tac_tree" model="ir.ui.view">
            <field name="name">lich_su_cong_tac</field>
            <field name="model">lich_su_cong_tac</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="nhan_vien_id"/>
                    <field name="chuc_vu_id"/>
                    <field name="don_vi_id"/>
                    <field name="loai_chuc_vu"/>
                </tree>
            </field>
        </record>

        <!-- SEARCH VIEW -->
        <record model="ir.ui.view" id="lich_su_cong_tac_search">
            <field name="model">lich_su_cong_tac</field>
            <field name="arch" type="xml">
                <search>
                    <field name="nhan_vien_id"/>
                    <field name="chuc_vu_id"/>
                    <field name="don_vi_id"/>
                    <field name="loai_chuc_vu"/>
                </search>
            </field>
        </record>

        <!-- ACTION -->
        <record id="action_lich_su_cong_tac" model="ir.actions.act_window">
            <field name="name">Lịch sử công tác</field>
            <field name="res_model">lich_su_cong_tac</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="lich_su_cong_tac_search"/>
        </record>
    </data>
</odoo>