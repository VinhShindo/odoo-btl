<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW -->
    <record id="view_van_ban_di_form" model="ir.ui.view">
        <field name="name">van_ban_di.form</field>
        <field name="model">van_ban_di</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Văn bản đi</h1>
                    </div>
                    <group col="4" string="Thông tin chung">
                        <field name="ten_van_ban" required="1"/>
                        <field name="so_van_ban_di" required="1"/>
                        <field name="so_hieu_van_ban" required="1"/>
                        <field name="noi_nhan"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_van_ban_di_tree" model="ir.ui.view">
        <field name="name">van_ban_di.tree</field>
        <field name="model">van_ban_di</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ten_van_ban"/>
                <field name="so_van_ban_di"/>
                <field name="so_hieu_van_ban"/>
                <field name="noi_nhan"/>
            </tree>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record model="ir.ui.view" id="van_ban_di_search">
        <field name="name">van_ban_di.search</field>
        <field name="model">van_ban_di</field>
        <field name="arch" type="xml">
            <search>
                <field name="ten_van_ban"/>
                <field name="so_van_ban_di"/>
                <field name="so_hieu_van_ban"/>
                <field name="noi_nhan"/>
            </search>
        </field>
    </record>
</odoo>