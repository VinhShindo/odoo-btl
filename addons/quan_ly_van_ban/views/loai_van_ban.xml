<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW -->
    <record id="view_loai_van_ban_form" model="ir.ui.view">
        <field name="name">loai_van_ban.form</field>
        <field name="model">loai_van_ban</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1>Loại văn bản</h1>
                    </div>
                    <group col="4" string="Thông tin chung">
                        <field name="ma_loai_van_ban" required="1"/>
                        <field name="ten_loai_van_ban" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_loai_van_ban_tree" model="ir.ui.view">
        <field name="name">loai_van_ban.tree</field>
        <field name="model">loai_van_ban</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ma_loai_van_ban"/>
                <field name="ten_loai_van_ban"/>
            </tree>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record model="ir.ui.view" id="loai_van_ban_search">
        <field name="name">loai_van_ban.search</field>
        <field name="model">loai_van_ban</field>
        <field name="arch" type="xml">
            <search>
                <field name="ma_loai_van_ban"/>
                <field name="ten_loai_van_ban"/>
            </search>
        </field>
    </record>
</odoo>