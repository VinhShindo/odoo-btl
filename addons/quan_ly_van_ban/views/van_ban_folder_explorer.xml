<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- CLIENT ACTION CHO FOLDER EXPLORER -->
    <record id="action_van_ban_folder_explorer" model="ir.actions.client">
        <field name="name">Folder Explorer</field>
        <field name="tag">folder_explorer</field>
        <field name="params" eval="{'model': 'van_ban.folder'}"/>
    </record>

    <!-- KANBAN VIEW DẠNG ICON FOLDER -->
    <record id="view_van_ban_folder_kanban_icon" model="ir.ui.view">
        <field name="name">van_ban.folder.kanban.icon</field>
        <field name="model">van_ban.folder</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_folder_explorer">
                <field name="id"/>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="document_count"/>
                <field name="child_ids"/>
                <field name="parent_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click oe_kanban_folder_item" 
                             t-att-data-folder-id="record.id.raw_value"
                             style="cursor: pointer; text-align: center; padding: 15px;">
                            <div class="o_kanban_image">
                                <i class="fa fa-folder-open-o" 
                                   style="font-size: 64px; color: #f4c542; margin-bottom: 10px;"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title" style="font-size: 14px;">
                                    <field name="name"/>
                                </strong>
                                <div class="text-muted" style="font-size: 12px;">
                                    <i class="fa fa-file-text-o"/> 
                                    <t t-esc="record.document_count.value or 0"/> văn bản
                                </div>
                                <div t-if="record.child_ids.value.length > 0" class="text-muted" style="font-size: 11px;">
                                    <i class="fa fa-folder-o"/> 
                                    <t t-esc="record.child_ids.value.length"/> thư mục con
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ACTION WINDOW -->
    <record id="action_van_ban_folder_explorer_window" model="ir.actions.act_window">
        <field name="name">Thư mục văn bản</field>
        <field name="res_model">van_ban.folder</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_id" ref="view_van_ban_folder_kanban_icon"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo thư mục để tổ chức văn bản
            </p>
        </field>
    </record>
</odoo>