<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW -->
    <record id="view_van_ban_den_form" model="ir.ui.view">
        <field name="name">van_ban_den.form</field>
        <field name="model">van_ban_den</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_xac_nhan_xu_ly" type="object" 
                                class="oe_stat_button" icon="fa-check"
                                attrs="{'invisible': [('trang_thai', 'not in', ['moi','dang_xu_ly'])]}"
                                string="Xác nhận xử lý"/>
                        <button name="action_luu_tru" type="object" 
                                class="oe_stat_button" icon="fa-archive"
                                attrs="{'invisible': [('trang_thai', '!=', 'da_xu_ly')]}"
                                string="Lưu trữ"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="ten_van_ban" placeholder="Tên văn bản"/>
                        </h1>
                    </div>
                    <notebook>
                        <page string="Thông tin chung">
                            <group col="4" string="Thông tin cơ bản">
                                <field name="so_van_ban_den" required="1" placeholder="Số văn bản đến"/>
                                <field name="so_hieu_van_ban" required="1" placeholder="Số hiệu"/>
                                <field name="loai_van_ban_id" required="1"/>
                                <field name="trang_thai" widget="badge" 
                                       attrs="{'readonly': [('trang_thai', 'in', ['da_xu_ly','luu_tru'])]}"/>
                            </group>
                            <group col="4" string="Thông tin thời gian">
                                <field name="ngay_ban_hanh"/>
                                <field name="ngay_den" required="1"/>
                            </group>
                            <group col="4" string="Thông tin liên quan">
                                <field name="document_id" options="{'no_create': True}"/>
                                <field name="customer_id" options="{'no_create': True}"/>
                                <field name="noi_gui_den" placeholder="Nơi gửi đến"/>
                                <field name="nguoi_ky" placeholder="Người ký"/>
                                <field name="so_ban"/>
                            </group>
                            <group col="4" string="Nhân sự xử lý">
                                <field name="nhan_vien_nhan_id" options="{'no_create': True}"/>
                                <field name="nhan_vien_chuyen_id" options="{'no_create': True}"/>
                            </group>
                            <group col="2" string="Nội dung">
                                <field name="trich_yeu" nolabel="1" placeholder="Trích yếu nội dung"/>
                                <field name="ghi_chu" nolabel="1" placeholder="Ghi chú"/>
                            </group>
                            <group col="2" string="File đính kèm">
                                <field name="file_dinh_kem" filename="ten_file" 
                                       attrs="{'invisible': [('file_dinh_kem', '=', False)]}"/>
                            </group>
                        </page>
                        <page string="Lịch sử xử lý" attrs="{'invisible': [('trang_thai', '=', 'moi')]}">
                            <group string="Quá trình xử lý">
                                <field name="lich_su_xu_ly" nolabel="1" 
                                       placeholder="Lịch sử xử lý văn bản sẽ hiển thị tại đây"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_van_ban_den_tree" model="ir.ui.view">
        <field name="name">van_ban_den.tree</field>
        <field name="model">van_ban_den</field>
        <field name="arch" type="xml">
            <tree>
                <field name="ten_van_ban" string="Tên văn bản"/>
                <field name="so_van_ban_den" string="Số đến"/>
                <field name="so_hieu_van_ban" string="Số hiệu"/>
                <field name="loai_van_ban_id" string="Loại VB"/>
                <field name="customer_id" string="Khách hàng"/>
                <field name="noi_gui_den" string="Nơi gửi"/>
                <field name="ngay_den" string="Ngày đến" widget="date"/>
                <field name="trang_thai" string="Trạng thái" widget="badge"/>
                <field name="nhan_vien_nhan_id" string="Người nhận"/>
            </tree>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record model="ir.ui.view" id="van_ban_den_search">
        <field name="name">van_ban_den.search</field>
        <field name="model">van_ban_den</field>
        <field name="arch" type="xml">
            <search>
                <field name="ten_van_ban"/>
                <field name="so_van_ban_den"/>
                <field name="so_hieu_van_ban"/>
                <field name="noi_gui_den"/>
                <field name="trich_yeu"/>
                <field name="customer_id"/>
                <filter name="trang_thai_moi" string="Mới nhận" domain="[('trang_thai','=','moi')]"/>
                <filter name="trang_thai_dang_xu_ly" string="Đang xử lý" domain="[('trang_thai','=','dang_xu_ly')]"/>
                <filter name="trang_thai_da_xu_ly" string="Đã xử lý" domain="[('trang_thai','=','da_xu_ly')]"/>
                <separator/>
                <filter name="filter_ngay_den" string="Ngày đến" date="ngay_den"/>
                <group expand="0" string="Nhóm theo">
                    <filter name="group_by_trang_thai" string="Trạng thái" context="{'group_by':'trang_thai'}"/>
                    <filter name="group_by_loai" string="Loại văn bản" context="{'group_by':'loai_van_ban_id'}"/>
                    <filter name="group_by_khach_hang" string="Khách hàng" context="{'group_by':'customer_id'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>