<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW -->
    <record id="view_van_ban_routing_form" model="ir.ui.view">
        <field name="name">van_ban.routing.form</field>
        <field name="model">van_ban.routing</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_in_progress" type="object" string="Đang xử lý" 
                            class="btn-primary" attrs="{'invisible': [('stage', '!=', 'to_process')]}"/>
                    <button name="action_set_done" type="object" string="Hoàn tất" 
                            class="btn-success" attrs="{'invisible': [('stage', '!=', 'in_progress')]}"/>
                    <button name="action_reject" type="object" string="Từ chối" 
                            class="btn-danger" attrs="{'invisible': [('stage', 'in', ['done','rejected'])]}"/>
                    <field name="stage" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Tiêu đề quy trình..."/>
                        </h1>
                    </div>
                    <group col="4" string="Thông tin xử lý">
                        <group>
                            <field name="document_id" required="1"/>
                            <field name="assigned_to" required="1"/>
                        </group>
                        <group>
                            <field name="date_deadline"/>
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="view_van_ban_routing_tree" model="ir.ui.view">
        <field name="name">van_ban.routing.tree</field>
        <field name="model">van_ban.routing</field>
        <field name="arch" type="xml">
            <tree decoration-success="stage == 'done'"
                  decoration-warning="stage == 'in_progress'"
                  decoration-danger="stage == 'rejected'">
                <field name="name"/>
                <field name="document_id"/>
                <field name="assigned_to"/>
                <field name="stage"/>
                <field name="date_deadline"/>
            </tree>
        </field>
    </record>

    <!-- SEARCH VIEW - ĐÃ SỬA LỖI -->
    <record model="ir.ui.view" id="van_ban_routing_search">
        <field name="name">van_ban.routing.search</field>
        <field name="model">van_ban.routing</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_id"/>
                <field name="assigned_to"/>
                <filter string="Chờ xử lý" name="to_process" domain="[('stage','=','to_process')]"/>
                <filter string="Đang xử lý" name="in_progress" domain="[('stage','=','in_progress')]"/>
                <filter string="Hoàn tất" name="done" domain="[('stage','=','done')]"/>
                <filter string="Từ chối" name="rejected" domain="[('stage','=','rejected')]"/>
                <!-- ĐÃ SỬA: Bỏ filter quá hạn hoặc sử dụng đúng cú pháp -->
                <filter string="Quá hạn" name="overdue" domain="[('date_deadline','&lt;',context_today),('stage','not in',['done','rejected'])]"/>
            </search>
        </field>
    </record>
</odoo>